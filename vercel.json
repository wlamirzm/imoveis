{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/cron-scraper", "destination": "/api/cron-scraper.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-scraper",
      "schedule": "0 8 * * *"
    }
  ]
}
